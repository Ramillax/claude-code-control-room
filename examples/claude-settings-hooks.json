{
  "statusLine": {
    "type": "command",
    "command": "python3 /PATH/TO/claude-code-control-room/hooks/cr-statusline.py"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /PATH/TO/claude-code-control-room/hooks/cr-state-hook.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /PATH/TO/claude-code-control-room/hooks/cr-context-hook.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /PATH/TO/claude-code-control-room/hooks/cr-state-hook.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /PATH/TO/claude-code-control-room/hooks/cr-state-hook.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /PATH/TO/claude-code-control-room/hooks/cr-guard-hook.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /PATH/TO/claude-code-control-room/hooks/cr-state-hook.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /PATH/TO/claude-code-control-room/hooks/cr-history-hook.py"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /PATH/TO/claude-code-control-room/hooks/cr-state-hook.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /PATH/TO/claude-code-control-room/hooks/cr-state-hook.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /PATH/TO/claude-code-control-room/hooks/cr-state-hook.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /PATH/TO/claude-code-control-room/hooks/cr-context-hook.py"
          }
        ]
      }
    ]
  }
}
