# controlroom.env — copy to controlroom.env and edit. Loaded by start.sh (and cr-session).
# Every value is optional; the defaults are shown.

# ── Network ─────────────────────────────────────────────────────────────────────────────
# The server has NO authentication. Keep it on localhost and put your own auth in front
# (see README → Security). Only change CR_BIND if your auth proxy runs on another host.
CR_BIND=127.0.0.1
CR_PORT=7680

# ── Sessions ────────────────────────────────────────────────────────────────────────────
# Allowlist of tmux session names the UI may open (one tile each). Anything else is refused.
CR_SESSIONS="claude1 claude2 claude3 claude4 shell"
# Which of them are a plain shell instead of Claude Code
CR_SHELL_SESSIONS="shell"
# Directory new sessions start in (your project)
CR_WORKDIR="$HOME"
# What a Claude tile runs when its session is first created
CR_CLAUDE_CMD="claude --resume"
# Use a dedicated tmux server (tmux -L <name>) so the UI never touches your other tmux sessions
#CR_TMUX_SOCKET=controlroom
# Make Claude sessions the kernel's first OOM victim on a small box (recoverable with --resume)
#CR_OOM_SCORE_ADJ=800

# ── Files ───────────────────────────────────────────────────────────────────────────────
# uploads/, outbox/ and dictations/ live here. Inside CR_WORKDIR on purpose: Claude Code asks
# for permission to read outside its working directory. Add ".controlroom/" to .gitignore.
#CR_DATA_DIR="$CR_WORKDIR/.controlroom"
# Folders the 📥 dialog may browse (colon-separated). Keep it narrow: it can download anything inside.
#CR_FILE_ROOTS="$CR_WORKDIR:$CR_WORKDIR/.controlroom"

# ── Dictation (🎤) — optional, OFF by default ───────────────────────────────────────────
# Needs your own Whisper API: "openai" or "azure". Leave empty and the 🎤 button is hidden.
CR_STT_PROVIDER=
# Language hint (ISO code like en, es, de). Empty = auto-detect.
CR_STT_LANGUAGE=
# Spelling hints: ONLY proper nouns / jargon, comma-separated, keep it under ~150 chars.
# Prose here makes transcription WORSE (it is decoder context, not an instruction).
CR_STT_PROMPT=
#   OpenAI:
#OPENAI_API_KEY=sk-...
#CR_STT_MODEL=whisper-1
#   Azure OpenAI (deploy a "whisper" model in your resource first):
#AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
#AZURE_OPENAI_API_KEY=your-key
#AZURE_WHISPER_DEPLOYMENT=whisper
#AZURE_OPENAI_API_VERSION=2024-06-01
# Hallucination filter thresholds (per segment). Defaults were measured, see server.py.
#CR_STT_NO_SPEECH=0.60
#CR_STT_LOGPROB=-1.00
#CR_STT_COMPRESS=2.40
